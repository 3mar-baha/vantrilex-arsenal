# Dependencies
node_modules/
.pnpm-store/

# Build / tooling output
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Root-level copies of the registry are never tracked. The canonical records
# live under registry/; an external re-sync of the v1 input package dropped
# duplicates at the repository root, which silently shadowed registry/ and
# reintroduced the pre-repair catalog. Ignore them by exact path so a future
# re-sync cannot commit a stale duplicate over the canonical tree.
/agents/
/hooks/
/mcp/
/plugins/
/skills/
/VANTRILEX_CATALOG.md

# The v1 input package also drops specification copies at the root. The
# canonical specs are tracked under docs/spec/.
/VANTRILEX_KIT_SPEC.md
/VANTRILEX_SKILLS_SPEC.md

# Environment and secrets — never commit real values
.env
.env.*

# Git worktree pool created by scripts/dispatch-worktrees.sh
.worktrees/
worktrees/

# Agent / editor scratch
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Python bytecode — the Arsenal toolchain is Node-only, but never commit these
__pycache__/
*.py[cod]

# Local verification scratch
.verify-cache/
*.tmp
# Phase components injected at runtime by scripts/orchestrate-stage.sh — never tracked
.opencode/kit/
# Concern briefing written at runtime by scripts/dispatch-worktrees.sh — never tracked
.opencode/STREAM.md