{
  "$schema": "https://opencode.ai/config.json",
  // Vantrilex Arsenal companion-config template (BLAZAR routing).
  // Copy these keys into the target project's opencode.jsonc and merge
  // additively: keep every owner key outside this set untouched.
  // The merged routing takes effect at the NEXT RUNTIME RESTART. Claiming
  // the new routing before the restart certifies what never executed.
  // Shape follows https://opencode.ai/v2/docs/config/: `agents` (plural)
  // with `disabled`, `experimental.subagent_depth`, and compaction keeps
  // on tokens and buffer only. There is deliberately NO `instructions`
  // array: the V2 runtime auto-loads AGENTS.md and AGENTS.md alone, so an
  // instructions array would be a second, inert source of directives.
  // Vantrilex Arsenal plugin entry (W-29, corrected 2026-11-12).
  // No published npm coordinate exists for this plugin: the npm registry
  // returns 404 for both "@3mar-baha/vantrilex-arsenal" and
  // "vantrilex-arsenal" (measured 2026-11-11). The Arsenal ships as an
  // in-tree plugin whose entry point is `.opencode/plugin/arsenal.ts`
  // (a file, its own kind of distribution: the tree). Configured local
  // paths must be DIRECTORIES — a path to a single `.ts` file is skipped
  // (see https://opencode.ai/v2/docs/plugins/, checked 2026-11-12).
  // The example below therefore names this repo's plugin DIRECTORY,
  // relative to the config file that carries it; relative paths resolve
  // from the config file containing the entry. This is an example, not a
  // verified install: no target-project install using this exact value
  // has been executed and verified from this lane, and the in-tree file
  // remains the shipped artifact until one is.
  // The live config schema (https://opencode.ai/config.json, fetched
  // 2026-11-12; top-level additionalProperties: false) names this key
  // `plugins` (plural) and marks singular `plugin` deprecated; the F-28
  // final-fix lane renames it accordingly.
  "plugins": [
    "./.opencode/plugin"
  ],
  // W-29: MCP servers, config-first (renamed 2026-11-12 per the live schema).
  // Filled by scripts/emit-mcp-config.mjs from .opencode/equip.manifest.json
  // (the mcp/ tokens) + registry/catalog.json. Every entry is D54-gated at
  // emit time: version_pin required, plus a resolvable package
  // (install_cmd → local) or a `remoteUrl` field (→ remote). Anything else is
  // named on stdout and REFUSED, never silently skipped.
  // Commented example — the exact shape the emitter writes today for this
  // repo's selection (2026-11-12; the tracked `.opencode/opencode.json`
  // still carries the pre-rename `mcpServers` form until the re-emission
  // commit lands):
  //   "memory": {
  //     "type": "local",
  //     "command": ["npx", "-y", "@modelcontextprotocol/server-memory"]
  //   }
  // Entries appear only for selected MCPs that clear the pin+command bar;
  // measured 2026-11-12: 8 of 14 (gmail, notion, context7, github,
  // sequential-thinking, firecrawl, browserbase, memory); 6 refused
  // (deepwiki, mem0-memory-mcp, discord, figma-context-mcp, slack,
  // subhatta123-twilize).
  // The live V2 schema (https://opencode.ai/config.json, fetched
  // 2026-11-12) spells MCP as `mcp.servers.<name>` —
  // `Mcp.LocalConfigEncoded` { type: "local", command: string[] } |
  // `Mcp.RemoteConfigEncoded` { type: "remote", url } — under a
  // top-level additionalProperties: false; the F-28 final-fix lane
  // renamed the emitter and this template accordingly.
  "mcp": {
    "servers": {
      // placeholder — intentionally empty; the W-29 emitter fills this block
    }
  },
  "default_agent": "blazar",
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  },
  "experimental": {
    "subagent_depth": 4
  },
  "compaction": {
    // Starting points taken from the compaction config example; tune to
    // the project and record the reason beside the changed value.
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  }
}
